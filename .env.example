# Azure Storage Deployment Configuration
# Copy this file to .env.local and fill in your actual values
# .env.local should be added to .gitignore and NOT committed to version control

# Azure Storage account name (e.g., mystorageaccount)
AZURE_STORAGE_ACCOUNT_NAME=your_storage_account_name

# Azure resource group name containing the storage account
AZURE_RESOURCE_GROUP_NAME=your_resource_group_name

# Azure subscription ID (optional, if multiple subscriptions exist)
# AZURE_SUBSCRIPTION_ID=your_subscription_id
